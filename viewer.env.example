# Sovereign Tower Explorer — optional KEY=VALUE path config.
# Copy to `viewer.env` next to this file (or set the same variables in your
# environment). Resolution priority is: CLI args > env vars > viewer.env >
# portable defaults. Relative values resolve against the working directory.
#
# Any of these keys can be omitted; the script falls back to its default.
# In the standard repo layout the defaults already point into ../game/, so a
# viewer.env is only needed when the data lives elsewhere.

# Root of the extracted Godot project (contains content/, systems/, lang/).
# Used by build_app.py (quest-data pass) and quest_data.py.
GAME_ROOT = /app/game/SovereignTowerCode

# Root containing <locale>/master.ink.json (compiled ink story) — build only.
# In the repo only en/ is kept; other locales are decoded in-memory by default,
# or written on demand via `build_app.py --extract-ink` / `ink_extract.py`
# (see explorer/README.md "Ink source").
INK_ROOT = /app/game/InkExtracted

# Output directory for the generated static site — build only.
INK_OUT = /app/explorer/dist

# Output file for the standalone quest-data import (quest_data.py only).
QUEST_OUT = /app/explorer/dist/quests.json

# Absolute URL of the deployed site root, trailing slash optional (build only).
# Feeds the per-route page shells' canonical / Open Graph / JSON-LD urls.
# Leave unset for local builds — the shells then use root-relative URLs.
# Set it to the real deployment origin before the final dist/ build, e.g.
#   SITE_BASE = https://<user>.github.io/<repo>/
SITE_BASE = https://example.com/explorer/